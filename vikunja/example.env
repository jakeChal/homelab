# Database password — used by both the db and vikunja containers
VIKUNJA_DB_PASSWORD=change-me-strong-db-password

# Secret key for JWT token signing — generate with: openssl rand -hex 32
VIKUNJA_SECRET=change-me-to-a-long-random-string

# Public URL where Vikunja is accessible (used by the browser for API requests)
# Use http://vikunja.home/ for LAN-only access
# Change to your Tailscale URL if accessing over Tailscale (https://vikunja.yourtailnet.ts.net/)
VIKUNJA_PUBLIC_URL=http://vikunja.home/
